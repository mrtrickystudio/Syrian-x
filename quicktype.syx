save,addchar.set and randomgennum,rng.0-67
execute,rngtochar
append str,challenge.pickedchar
inc,buildcount
end

save,buildchallenge.Change str,challenge.
Change int,buildcount.0
while int less,buildcount.length!addchar
end

save,showstatus.int to str,score
Change str,scorestr.SCORE: 
int to str,score
append str,scorestr.score
Change str,lengthstr. | LENGTH: 
append str,scorestr.lengthstr
int to str,length
append str,scorestr.length
Change str,lengthstr. chars
append str,scorestr.lengthstr
Change str,streakstr. | STREAK: 
append str,scorestr.streakstr
int to str,streak
append str,scorestr.streak
Change str,winsstr./
append str,scorestr.winsstr
int to str,winsneeded
append str,scorestr.winsneeded
print str,scorestr
end

save,doround.clear screen
execute,showstatus
print,----------------------------------------
print,Type exactly what you see - case sensitive!
print,
no new line print,>>> 
print str,challenge
print,
print,----------------------------------------
no new line print,Your input: 
set str to input,guess
if str equal,guess.challenge!correct
if str not equal,guess.challenge!wrong
end

save,correct.clear screen
print,
print, *** CORRECT! Great job! ***
print,
inc,score
inc,streak
if int equal,streak.winsneeded!growstring
execute,buildchallenge
execute,doround
end

save,wrong.clear screen
print,
print, XXX WRONG! XXX
print,
Change int to int,streak.zero
print, The correct string was:
no new line print,  >>> 
print str,challenge
print,
print,  Press ENTER to try a new round...
set str to input,guess
execute,buildchallenge
execute,doround
end

save,growstring.Change int to int,streak.zero
inc,length
print,
print, *** STRING LENGTH UP! ***
print,
if int equal,length.maxlength!hitcap
if int less,length.maxlength!updatethreshold
end

save,updatethreshold.Change int to int,winsneeded.length
end

save,hitcap.Change int,winsneeded.16
Change int,length.16
print, *** MAX DIFFICULTY REACHED - LENGTH 16! ***
print,
end

